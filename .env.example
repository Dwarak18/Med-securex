# PostgreSQL Configuration
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=cybersecurity
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=password

# API Gateway Configuration
# RAG_SERVICE_URL=http://localhost:8000

# External API Keys (Optional - for enhanced threat intelligence)
# VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
# SECURITYTRAIL_API_KEY=your_securitytrail_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# AI/ML Configuration
# USE_GEMINI=false
# MODEL_NAME=gemini-pro

# Development/Production Settings
# ENVIRONMENT=development
# DEBUG=false

# Network Agent Configuration
# VIRUSTOTAL_RATE_LIMIT=15
# SECURITYTRAIL_RATE_LIMIT=1

# Cyber Agents Configuration
# ENABLE_ATTACK_AGENT=true
# ENABLE_NETWORK_AGENT=true
# ENABLE_INVESTIGATION_AGENT=true