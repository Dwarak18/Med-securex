FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements file first
COPY requirements.txt ./

# Install Python dependencies from requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy the entire aiml_part directory (build context is ../aiml_part)
COPY . ./

# Create necessary directories
RUN mkdir -p /app/logs /app/models /app/models/tmp

# Set permissions
RUN chmod +x /app/*.py
RUN chmod -R 755 /app/cyberagents

# Set environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

# Extended health check for AI/ML service
HEALTHCHECK --interval=30s --timeout=15s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Use inline startup that handles model training and service initialization
CMD ["sh", "-c", "echo 'Starting AI/ML RAG Service...' && if [ ! -f /app/models/attack_model.joblib ] || [ ! -f /app/models/network_model.joblib ]; then echo 'Training models from datasets...' && python train_models.py && echo 'Model training completed!'; else echo 'Models already exist, skipping training.'; fi && echo 'Starting RAG service...' && uvicorn rag_service:app --host 0.0.0.0 --port 8000 --reload"]