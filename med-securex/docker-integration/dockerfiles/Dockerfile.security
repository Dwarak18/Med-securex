FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements files
COPY app/backend/requirements.txt ./
COPY docker-integration/config/requirements-gateway.txt ./additional-requirements.txt

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir -r additional-requirements.txt

# Copy all backend files
COPY app/backend/ .

# Create logs directory
RUN mkdir -p /app/logs

EXPOSE 9000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:9000/health || exit 1

CMD ["python", "-m", "uvicorn", "security_backend:app", "--host", "0.0.0.0", "--port", "9000"]
RUN pip install --no-cache-dir -r additional-requirements.txt

# Copy all backend files
COPY app/backend/ .
COPY docker-integration/config/security_backend_fixed.py ./security_backend.py
COPY app/backend/security_backend.py ./
COPY app/backend/owasp_rules.py ./
COPY app/backend/regex_rules.py ./
COPY app/backend/incident_logger.py ./

# Create logs directory
RUN mkdir -p /app/logs

EXPOSE 9000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:9000/health || exit 1

CMD ["python", "-m", "uvicorn", "security_backend:app", "--host", "0.0.0.0", "--port", "9000"]